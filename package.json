{
  "name": "LayerProof",
  "version": "0.3.4",
  "description": "Local PDF OCR quality review with an Excel control register",
  "private": true,
  "main": "src/main.cjs",
  "author": "Melken TechWork",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldgraybuzzard/layerproof.git"
  },
  "homepage": "https://github.com/oldgraybuzzard/layerproof#readme",
  "bugs": {
    "url": "https://github.com/oldgraybuzzard/layerproof/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:samples": "node scripts/check-samples.mjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dir --publish never",
    "dist:win:signed": "electron-builder --config electron-builder.signed.cjs --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.0",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kendallfelder.pdfocrqc",
    "productName": "LayerProof",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "src/assets/layerproof.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LayerProof",
      "uninstallDisplayName": "LayerProof",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "license": "LICENSE.txt"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "license": "LICENSE.txt"
    },
    "copyright": "Copyright \u00a9 2026 Melken TechWork"
  }
}
